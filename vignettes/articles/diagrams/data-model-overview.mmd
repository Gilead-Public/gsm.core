    direction TB
    clinical[("Clinical data<br>(EDC, labs, ...)")]
    ctms[("CTMS data<br>(study, site)")]
    workflows[("Metric workflows<br>(YAML meta)")]
  end

  mapped[("Mapped data")]
  analysis[("Analysis data")]
  reporting[("Reporting data")]
